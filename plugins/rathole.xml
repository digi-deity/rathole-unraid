<Plugin>
  <!-- Community Apps wrapper for the rathole plugin -->

  <!-- Name of the plugin -->
  <Name>rathole</Name>

  <!-- Plain text description -->
  <Overview>Installs and manages the rathole client on unRAID. rathole is a lightweight, high-performance reverse proxy that exposes local services on a NAT network to a public server. Includes a webGUI page to edit the client config and start/stop the daemon.</Overview>

  <!-- NOTE: PluginURL must match exactly the URL of the PluginURL in the .plg file -->
  <PluginURL>https://raw.githubusercontent.com/digi-deity/rathole-unraid/main/rathole.plg</PluginURL>

  <!-- Author of the plugin -->
  <PluginAuthor>digi-deity</PluginAuthor>

  <!-- The .plg has no <Support> attribute, so <Support> here is REQUIRED -->
  <!-- PLACEHOLDER: replace with the real unRAID forum support topic once it exists -->
  <Support>https://forums.unraid.net/topic/PLACEHOLDER_RATHOLE_SUPPORT_TOPIC</Support>

  <!-- Project page -->
  <Project>https://github.com/digi-deity/rathole-unraid</Project>

  <!-- Readme first file -->
  <ReadMe>https://raw.githubusercontent.com/digi-deity/rathole-unraid/main/README.md</ReadMe>

  <!-- Valid category entries can be generated from the Application Categorizer plugin available in Apps -->
  <Category>Network</Category>

  <!-- App icon hosted at the repo root. IconFA is intentionally omitted:
       when IconFA is set, the Icon tag is ignored by Community Apps. -->
  <Icon>https://raw.githubusercontent.com/digi-deity/rathole-unraid/main/icon.png</Icon>

  <!-- License of the plugin -->
  <License>Apache 2.0</License>

  <!-- Minimum and maximum Unraid version -->
  <MinVer>6.9</MinVer>
  <MaxVer>7.3</MaxVer>

</Plugin>
